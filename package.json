{
  "name": "dsh-plastic-memory",
  "version": "2.0.0",
  "type": "module",
  "description": "可塑性记忆：双神经网络数字生命核心——操控型神经网络实时读写/增删记忆神经网络的神经元与参数；记忆神经网络按人脑分区（记忆/视觉/触觉/听觉/人格）承载长期人格化数据，以训练态发布（会话可影响权重）。工作区由用户指定，含感知文件夹（每秒扫描）。提供 API：直接操控操控网络，或经操控网络间接操控记忆网络。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "neural-network",
    "plastic-memory",
    "digital-life",
    "persona",
    "predictive-processing"
  ],
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.mjs",
    "lib/client.js",
    "lib/brain.mjs",
    "lib/workspace.mjs",
    "lib/nn/core.mjs",
    "lib/nn/network.mjs",
    "lib/nn/endocrine.mjs",
    "lib/nn/encoder.mjs",
    "lib/nn/memorynet.mjs",
    "lib/nn/controllernet.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT"
}
